+            "no_at_fault_collisions": pick(("no_at_fault_collisions", "nc"), 1.0),
+            "drivable_area_compliance": pick(("drivable_area_compliance", "dac"), 1.0),
+            "time_to_collision_within_bound": pick(("time_to_collision_within_bound", "ttc"), 1.0),
